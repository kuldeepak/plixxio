
{{ 'configurator.css' | asset_url | stylesheet_tag }}
<div class="config-wrapper"
  style="
    --custom-alert: {{ block.settings.banner_background_color }};

    --next-btn-bg: {{ block.settings.next__button_color }};
    --next-btn-text-color: {{ block.settings.next__button_text_color }};

    --add-to-cart-bg: {{ block.settings.add_to_cart_btn_color }};
    --add-to-cart-text: {{ block.settings.add_to_cart_btn_text_color }};
  "
>

  <!-- LEFT SIDE -->
  <div class="configurator-steps config-left" id="configuratorSteps" data-product-handle="{{ product.handle }}">

    <!-- BACK BUTTON -->
    <div class="title-back-btn">
      <h1 class="title">
        <a href="/" class="button_back" style="text-decoration:none;color:black;">
          <img src="https://cdn.shopify.com/extensions/019beb25-408f-70b4-9af9-8e2ffef35c2f/dev-1c8b5b1a-7798-4b7e-9065-4707d76812ce/assets/back.jpg">
          Zurück zur Produktauswahl
        </a>
      </h1>
      <hr class="main-sep">
    </div>

    <!-- ALERT -->
    <div class="custom-alert dd">
      <div class="image-div">
        <img src="https://cdn.shopify.com/extensions/019beb25-408f-70b4-9af9-8e2ffef35c2f/dev-1c8b5b1a-7798-4b7e-9065-4707d76812ce/assets/success.jpg">
      </div>
      <div class="text-div">
        Du hast <b class="pro_name">Nairobi</b> in <b class="color">anthrazit</b> als Stoff ausgewählt!
        Wähle als Nächstes die <b class="steps_name">Befestigung, Maße</b> etc.
      </div>
    </div>

    <!-- 🔥 STEPS WILL BE RENDERED BY JS -->
    <div id="dynamicSteps"></div>

    <!-- FINAL STEP -->
    <div class="config-step is-disabled" data-step="final" id="finalStep">
      <h2>Fertig</h2>

      <table class="final-summary" id="finalSummary"></table>


      <div class="quantity quantity__qty">
        <button class="qty-minus">-</button>
        <span class="qty-value">1</span>
        <button class="qty-plus">+</button>
      </div>

      <button class="primary-btn add-to-cart-btn">IN DEN WARENKORB</button>
    </div>

    <div class="vn-banner-slider-section">
<div class="vn-banner-slider-wraper">
    <div class="vn-banner-slide-wraper">
        <div class="vn-banner-slide">
        {% comment %} <img class="vn-desk" src="https://plixxo-de.myshopify.com/cdn/shop/files/Hero_Banner_15.png" alt=""> {% endcomment %}
     {% if block.settings.custom_image_id %}
  <img 
    class="vn-desk" 
    src="{{ block.settings.custom_image_id | image_url }}" 
    alt="{{ block.settings.custom_image_id.alt | escape }}"
    width=""
    height=""
  >
  {% else %}
    <img class="vn-desk" src="https://plixxo-de.myshopify.com/cdn/shop/files/Hero_Banner_15.png" alt="">
  {% endif %}
        <div class="vn-banner-slide-content" >
            <div class="vn-overflow">
            <h1>Konfiguriere dir deinen Sicht- & Sonnenschutz nach Maß</h1>
            </div>
     </div>
        </div>
    </div>
</div>
</div>
  </div>

  <!-- RIGHT SIDE -->
  <div class="config-right">

    <!-- ZOOM -->
<div class="zoom-wrapper">
  <div class="zoom-thumb"
       id="zoomThumb"
       data-fallback="https://cdn.shopify.com/extensions/019beb25-408f-70b4-9af9-8e2ffef35c2f/dev-1c8b5b1a-7798-4b7e-9065-4707d76812ce/assets/123.jpg"
       style="background-image:url('https://cdn.shopify.com/extensions/019beb25-408f-70b4-9af9-8e2ffef35c2f/dev-1c8b5b1a-7798-4b7e-9065-4707d76812ce/assets/123.jpg');">
  </div>

  <div class="zoom-preview"
       id="zoomPreview"
       style="background-image:url('https://cdn.shopify.com/extensions/019beb25-408f-70b4-9af9-8e2ffef35c2f/dev-1c8b5b1a-7798-4b7e-9065-4707d76812ce/assets/123.jpg');">
  </div> 


{% comment %} <div class="zoom-thumb"
     id="zoomThumb"
     data-default-image="{{ product.selected_or_first_available_variant.featured_image | default: product.featured_image | img_url: '800x' }}"
     style="background-image:url('{{ product.selected_or_first_available_variant.featured_image | default: product.featured_image | img_url: '800x' }}');">
</div>

<div class="zoom-preview"
     id="zoomPreview"
     style="background-image:url('{{ product.selected_or_first_available_variant.featured_image | default: product.featured_image | img_url: '800x' }}');">
</div> {% endcomment %}
</div> 



    <!-- SUMMARY -->
    <div class="summary-box" id="summaryBoxAlt">
      <h3>Zusammenfassung</h3>

      <ul id="summaryBoxAltList"></ul>


      <div class="summary-price-versand">
        <div class="summary-price">
          <div><span>Zwischensumme</span><b>—</b></div>
          <div><span>Versand</span><b>kostenlos</b></div>
        </div>
        <div class="total"><span>Gesamt</span><b>—</b></div>
      </div>
    </div>
  </div>
</div>


{{ 'configurator.js' | asset_url | script_tag }}



{% schema %}
{
  "name": "configurator",
  "target": "section",
  "settings": [
     {
      "type": "color",
      "id": "banner_background_color",
      "label": "Banner Background Color",
      "default": "#f6ebce"
    },
    {
      "type": "color",
      "id": "next__button_color",
      "label": "Next Button Background",
      "default": "#E5C675"
    },
    {
      "type": "color",
      "id": "next__button_text_color",
      "label": "Next Button Color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "add_to_cart_btn_color",
      "label": "AddToCart Button Color",
      "default": "#e7c97a"
    },
     {
      "type": "color",
      "id": "add_to_cart_btn_text_color",
      "label": "AddToCart Button Text Color",
      "default": "#000"
    },
    {
      "type": "image_picker",
      "id": "custom_image_id",
      "label": "Choose an Image"
    }
  ]
}
{% endschema %}

<style>
.custom-alert {
  background-color: var(--custom-alert);
}

.config-step button {
  background-color: var(--next-btn-bg);
  color: var(--next-btn-text-color);
}

.config-wrapper .add-to-cart-btn {
  background-color: var(--add-to-cart-bg);
  color: var(--add-to-cart-text);

}

</style>